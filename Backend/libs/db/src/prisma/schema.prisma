//TODO history created, edited, status change
model Antipixel {
  id Int @id @default(autoincrement())

  name String
  path String

  submittedBy User @relation(fields: [userId], references: [id])
  userId      Int

  createdAt DateTime @default(now())

  tags TagOnAntipixel[]

  hashToAntipixel   HashToAntipixel @relation(fields: [hashToAntipixelId], references: [id])
  hashToAntipixelId Int
}
