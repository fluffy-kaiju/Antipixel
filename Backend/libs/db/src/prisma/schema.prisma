// This is your Prisma schema file,

generator client {
  provider            = "prisma-client"
  output              = "./generated/"
  moduleFormat        = "cjs"
  // Fix using `prisma-client` with monorepo standalone lib https://github.com/prisma/prisma/issues/28627#issuecomment-3567033856
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// #########################################################################
// #                                                                       #
// #                    Permssion and roles                                #
// #                                                                       #
// #########################################################################

model Permission {
  id Int @id @default(autoincrement())

  name String @unique

  roles PermissionOnRole[]
}

model PermissionOnRole {
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int

  role   Role @relation(fields: [roleId], references: [id])
  roleId Int

  @@id([permissionId, roleId])
}

model Role {
  id Int @id @default(autoincrement())

  name String

  createdBy       User @relation(fields: [createdByUserId], references: [id])
  createdByUserId Int

  permissions PermissionOnRole[]
}

// #########################################################################
// #                                                                       #
// #                            User Model                                 #
// #                                                                       #
// #########################################################################

enum EUserAccountStatus {
  NOOB
  PRO
  ADMIN
  SYSTEM
}

//TODO create permissions and allow to create roles
model User {
  id       Int    @id @default(autoincrement())
  userName String @unique

  status         EUserAccountStatus  @default(NOOB)
  accountHistory UserStatusHistory[] @relation("AccountHistory")

  email                 String                 @unique
  emailConfirmationCode EmailConfirmationCode?
  emailIsVerified       Boolean                @default(false)

  passwordHash  String
  passwordReset PasswordResetCode?

  rolesCreated           Role[]
  antipixelsSubmitted    Antipixel[]
  userStatusUpdated      UserStatusHistory[] @relation("ChangesMadeBy")
  tagCreated             Tag[]
  tagOnAntipixelAssigned TagOnAntipixel[]
  tagsStatusUpdated      TagsStatusHistory[]
}

model EmailConfirmationCode {
  id Int @id @default(autoincrement())

  // https://www.prisma.io/docs/orm/reference/prisma-schema-reference#cuid
  token String @unique @default(cuid(2))

  TTL_sec   Int
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique
}

model PasswordResetCode {
  id Int @id @default(autoincrement())

  // https://www.prisma.io/docs/orm/reference/prisma-schema-reference#cuid
  token String @unique @default(cuid(2))

  TTL_sec   Int
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique
}

model UserStatusHistory {
  id Int @id @default(autoincrement())

  user   User @relation("AccountHistory", fields: [userId], references: [id])
  userId Int

  status EUserAccountStatus

  reason String

  changeMadeBy       User @relation("ChangesMadeBy", fields: [changeMadeByUserId], references: [id])
  changeMadeByUserId Int

  changeMadeAt DateTime @default(now())
}

// #########################################################################
// #                                                                       #
// #                            Tag Model                                  #
// #                                                                       #
// #########################################################################

enum ETagsStatus {
  PENDING
  ACTIVE
  DELETED
  FLAGGED
}

model Tag {
  id Int @id @default(autoincrement())

  name        String
  description String

  status        ETagsStatus         @default(PENDING)
  statusHistory TagsStatusHistory[]

  antipixels TagOnAntipixel[]

  createdBy User @relation(fields: [userId], references: [id])
  userId    Int
}

model TagsStatusHistory {
  id Int @id @default(autoincrement())

  tag   Tag @relation(fields: [tagId], references: [id])
  tagId Int

  changeMadeBy       User @relation(fields: [changeMadeByUserId], references: [id])
  changeMadeByUserId Int

  status ETagsStatus

  changeMadeAt DateTime @default(now())
  reason       String
}

model TagOnAntipixel {
  tag   Tag @relation(fields: [tagId], references: [id])
  tagId Int

  antipixel   Antipixel @relation(fields: [antipixelId], references: [id])
  antipixelId Int

  assignedAt DateTime @default(now())

  assignedBy User @relation(fields: [userId], references: [id])
  userId     Int

  @@id([tagId, antipixelId])
}

// #########################################################################
// #                                                                       #
// #                            Antipixel Model                            #
// #                                                                       #
// #########################################################################

model HashToAntipixel {
  id         Int         @id @default(autoincrement())
  hash       String      @unique
  antipixels Antipixel[]
}

enum EVirusScanStatus {
  PENDING
  SCANNING
  SAFE
  UNSAFE
}

